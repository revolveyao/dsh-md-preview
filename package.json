{
  "name": "dsh-md-preview",
  "version": "0.1.0",
  "description": "Markdown preview, workspace/skill file tree and editing for the DSH Web GUI: markdown-exit + Shiki with ColaMD themes.",
  "type": "module",
  "main": "src/host/index.js",
  "exports": {
    ".": "./src/host/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "files": [
    "lib",
    "src",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "test": "node tests/smoke.mjs && node tests/client-load.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.4.0",
    "@mdit/plugin-anchor": "^2.2.0",
    "@mdit/plugin-tex": "^1.1.1",
    "@shikijs/engine-javascript": "^4.4.3",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "katex": "^0.18.7",
    "markdown-exit": "^1.3.0",
    "mermaid": "^11.4.0",
    "shiki": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^30.1.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "markdown",
    "preview"
  ],
  "license": "MIT"
}
